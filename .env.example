# NetCartographer Configuration File
# Copy this file to .env and customize for your environment

# Network Scanning Configuration
TARGET_CIDR=192.168.1.0/24
GATEWAY_IP=192.168.1.1
SCAN_INTERFACE=eth0
SCAN_PORTS=22,80,443,161,8080

# Timeout Configuration (seconds)
PORT_SCAN_TIMEOUT=1.5
ARP_TIMEOUT=2.0
TRACEROUTE_MAX_HOPS=15
TRACEROUTE_TIMEOUT=2.0

# Daemon Configuration
DAEMON_INTERVAL=60
STATE_FILE=/tmp/net_cartographer_state.json
LOG_FILE=/var/log/net_cartographer.log

# Webhook Alerts
WEBHOOK_URL=http://localhost:9000/webhook

# Ansible Configuration
ANSIBLE_SSH_USER=ubuntu
ANSIBLE_SSH_KEY=~/.ssh/id_rsa

# Output Configuration
OUTPUT_DIR=./output
TOPOLOGY_HTML=./output/topology.html
